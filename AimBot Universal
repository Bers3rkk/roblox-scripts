local ESPObjects = {}

local function GetTeamColor(player)
    if Config.ESPTeamColor and player.Team and player.Team.TeamColor then
        return player.Team.TeamColor.Color
    end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return Color3.fromRGB(0, 140, 255)
    end
    return Color3.fromRGB(255, 55, 55)
end

local function CreateESP(player)
    if ESPObjects[player] then return end
    ESPObjects[player] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Dist = Drawing.new("Text")
    }
    local d = ESPObjects[player]
    d.Box.Thickness = 1
    d.Box.Filled = false
    d.Name.Size = 14
    d.Name.Center = true
    d.Name.Outline = true
    d.Dist.Size = 12
    d.Dist.Center = true
    d.Dist.Outline = true
end

local function RemoveESP(player)
    local d = ESPObjects[player]
    if d then
        d.Box:Remove()
        d.Name:Remove()
        d.Dist:Remove()
        ESPObjects[player] = nil
    end
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateESP(p) end
end

local function isAlive(char)
    local h = char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isVisible(part)
    if not Config.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local res = workspace:Raycast(origin, dir, params)
    return res == nil or res.Instance:IsDescendantOf(part.Parent)
end

local function getClosest()
    local closest, closestPart = nil, nil
    local shortest = Config.FOV
    local viewport = Camera.ViewportSize
    local screenCenter = Vector2.new(viewport.X / 2, viewport.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Config.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end

        local char = plr.Character
        if not isAlive(char) then continue end

        local part = char:FindFirstChild(Config.AimPart) or char:FindFirstChild("Head")
        if not part or not isVisible(part) then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if dist < shortest then
            shortest = dist
            closest = plr
            closestPart = part
        end
    end
    return closest, closestPart
end

local frameCount, lastTime, currentFPS = 0, tick(), 0

RunService.RenderStepped:Connect(function()
    frameCount += 1
    if tick() - lastTime >= 0.4 then
        currentFPS = math.floor(frameCount / (tick() - lastTime))
        frameCount = 0
        lastTime = tick()
    end

    local ping = 0
    pcall(function()
        ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)

    if HubMinimized then
        FPSLabel.Text = "FPS: " .. currentFPS
        PingLabel.Text = "Ping: " .. ping .. "ms"
    end

    -- FOV CENTRALIZADO (sem offset)
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    FOVCircle.Position = center
    FOVCircle.Radius = Config.FOV
    FOVCircle.Visible = Config.ShowFOV

    if Config.Enabled then
        local targetPlr, targetPart = getClosest()
        if targetPart then
            local pred = targetPart.Position
            if Config.Prediction > 0 and targetPlr.Character then
                local root = targetPlr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    pred = targetPart.Position + root.AssemblyLinearVelocity * Config.Prediction
                end
            end
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pred), Config.Smoothness)
        end
    end

    for player, data in pairs(ESPObjects) do
        local char = player.Character
        if not Config.ESPEnabled or not char or not isAlive(char) then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            continue
        end

        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
        if not root then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            continue
        end

        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local dist = (Camera.CFrame.Position - root.Position).Magnitude

        if not onScreen or dist > Config.ESPMaxDistance then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            continue
        end

        local color = GetTeamColor(player)

        if Config.ESPBoxes then
            local size = math.clamp(2000 / dist, 8, 60)
            data.Box.Size = Vector2.new(size * 0.7, size)
            data.Box.Position = Vector2.new(pos.X - data.Box.Size.X / 2, pos.Y - data.Box.Size.Y / 2)
            data.Box.Color = color
            data.Box.Visible = true
        else
            data.Box.Visible = false
        end

        if Config.ESPNames then
            data.Name.Text = player.DisplayName
            data.Name.Position = Vector2.new(pos.X, pos.Y - (Config.ESPBoxes and data.Box.Size.Y / 2 + 16 or 20))
            data.Name.Color = color
            data.Name.Visible = true
        else
            data.Name.Visible = false
        end

        if Config.ESPDistance then
            data.Dist.Text = math.floor(dist) .. "m"
            data.Dist.Position = Vector2.new(pos.X, pos.Y + (Config.ESPBoxes and data.Box.Size.Y / 2 + 4 or 8))
            data.Dist.Color = color
            data.Dist.Visible = true
        else
            data.Dist.Visible = false
        end
    end
end)

