-- ================= SAVE / LOAD =================
local function SaveConfig()
    local data = {
        TeamCheck = Config.TeamCheck,
        WallCheck = Config.WallCheck,
        FOV = Config.FOV,
        Smoothness = Config.Smoothness,
        Prediction = Config.Prediction,
        ShowFOV = Config.ShowFOV,
        ESPEnabled = Config.ESPEnabled,
        ESPTeamColor = Config.ESPTeamColor,
        ESPBoxes = Config.ESPBoxes,
        ESPNames = Config.ESPNames,
        ESPDistance = Config.ESPDistance,
        CurrentPreset = Config.CurrentPreset,
        ToggleKey = tostring(Config.ToggleKey),
        MinimizeKey = tostring(Config.MinimizeKey)
    }
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local function LoadConfig()
    local success, content = pcall(function()
        return readfile(SAVE_FILE)
    end)
    if success and content then
        local data = HttpService:JSONDecode(content)
        if data then
            for k, v in pairs(data) do
                if Config[k] ~= nil and k ~= "ToggleKey" and k ~= "MinimizeKey" then
                    Config[k] = v
                end
            end
            if data.ToggleKey then
                local key = data.ToggleKey:gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
                Config.ToggleKey = Enum.KeyCode[key] or Enum.UserInputType[key] or Enum.KeyCode.E
            end
            if data.MinimizeKey then
                local key = data.MinimizeKey:gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
                Config.MinimizeKey = Enum.KeyCode[key] or Enum.UserInputType[key] or Enum.KeyCode.RightShift
            end
        end
    end
end

LoadConfig()

local function ApplyPreset(id)
    local p = Presets[id]
    if not p then return end
    Config.CurrentPreset = id
    Config.FOV = p.FOV
    Config.Smoothness = p.Smoothness
    Config.Prediction = p.Prediction
    Config.WallCheck = p.WallCheck
    Config.TeamCheck = p.TeamCheck
    Config.ShowFOV = p.ShowFOV
    SaveConfig()
end

