local function Notify(title, text, color)
    color = color or Color3.fromRGB(0, 140, 255)

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 260, 0, 62)
    notif.Position = UDim2.new(1, 40, 0, 0)
    notif.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    notif.BorderSizePixel = 0
    notif.Parent = NotifHolder
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = 1.5
    stroke.Parent = notif

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 4, 1, 0)
    accent.BackgroundColor3 = color
    accent.BorderSizePixel = 0
    accent.Parent = notif
    Instance.new("UICorner", accent).CornerRadius = UDim.new(0, 10)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -24, 0, 22)
    titleLbl.Position = UDim2.new(0, 16, 0, 8)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 14
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = notif

    local textLbl = Instance.new("TextLabel")
    textLbl.Size = UDim2.new(1, -24, 0, 18)
    textLbl.Position = UDim2.new(0, 16, 0, 32)
    textLbl.BackgroundTransparency = 1
    textLbl.Text = text
    textLbl.TextColor3 = Color3.fromRGB(170, 170, 190)
    textLbl.Font = Enum.Font.Gotham
    textLbl.TextSize = 12
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.Parent = notif

    table.insert(activeNotifs, notif)

    for i, n in ipairs(activeNotifs) do
        TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Position = UDim2.new(0, 0, 0, (i - 1) * 72)
        }):Play()
    end

    task.delay(2.4, function()
        local idx = table.find(activeNotifs, notif)
        if idx then table.remove(activeNotifs, idx) end
        local exit = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Position = UDim2.new(1, 40, 0, notif.Position.Y.Offset)
        })
        exit:Play()
        exit.Completed:Connect(function()
            notif:Destroy()
            for i, n in ipairs(activeNotifs) do
                TweenService:Create(n, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {
                    Position = UDim2.new(0, 0, 0, (i - 1) * 72)
                }):Play()
            end
        end)
    end)
end

