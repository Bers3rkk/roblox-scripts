-- ================= KEYBIND LISTENER =================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    if WaitingForKey then
        local newKey = nil
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            newKey = input.KeyCode
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.MouseButton2 or
               input.UserInputType == Enum.UserInputType.MouseButton3 then
            newKey = input.UserInputType
        end

        if newKey then
            if WaitingForKey == "Toggle" then
                Config.ToggleKey = newKey
                ToggleKeyBtn.Text = GetKeyName(newKey)
            else
                Config.MinimizeKey = newKey
                MinimizeKeyBtn.Text = GetKeyName(newKey)
            end
            WaitingForKey = nil
            ToggleKeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            MinimizeKeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            SaveConfig()
            Notify("Keybind Changed", GetKeyName(newKey), Color3.fromRGB(180, 140, 255))
        end
        return
    end

    local function matchKey(key)
        if typeof(key) ~= "EnumItem" then return false end
        if key.EnumType == Enum.KeyCode then
            return input.KeyCode == key
        elseif key.EnumType == Enum.UserInputType then
            return input.UserInputType == key
        end
        return false
    end

    if matchKey(Config.ToggleKey) then
        Config.Enabled = not Config.Enabled
        AimbotToggle.Set(Config.Enabled)
        if Config.Enabled then
            Notify("Aimbot Enabled", "Locking targets", Color3.fromRGB(0, 200, 100))
        else
            Notify("Aimbot Disabled", "Aimbot off", Color3.fromRGB(255, 80, 80))
        end
        SaveConfig()
    end

    if matchKey(Config.MinimizeKey) then
        SetMinimized(not HubMinimized)
    end
end)

