local fps, frames, last = 60, 0, tick()
RunService.RenderStepped:Connect(function()
    frames += 1
    if tick() - last >= 0.2 then
        fps = math.floor(frames / (tick() - last))
        frames = 0
        last = tick()
    end
end)

task.spawn(function()
    while ScreenGui.Parent do
        local ping = 0
        pcall(function()
            local item = Stats.Network.ServerStatsItem["Data Ping"]
            if item then ping = math.floor(item:GetValue()) end
        end)
        if ping == 0 then
            pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
        end
        local count = #Players:GetPlayers()
        StatsLabel.Text = string.format("FPS: %d | Ping: %dms | Players: %d", fps, ping, count)
        FloatLabel.Text = string.format("FPS: %d | Ping: %dms", fps, ping)
        task.wait(0.15)
    end
end)

Notify("Rejoin Auto Executed!", 2.5)
