task.spawn(function()
    while ScreenGui.Parent do
        if (Config.AutoMinimize ~= false) and Main.Visible and not Config.Hidden and not mouseOverHub then
            minimizeTimer = minimizeTimer + 0.5
            if minimizeTimer >= (Config.AutoMinimizeTime or 10) then
                SetHidden(true)
                minimizeTimer = 0
            end
        else
            if mouseOverHub then minimizeTimer = 0 end
        end
        task.wait(0.5)
    end
end)

