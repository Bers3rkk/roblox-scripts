local function AddFavorite()
    Config.Favorites = Config.Favorites or {}
    for _, fav in ipairs(Config.Favorites) do
        if fav.JobId == JobId then
            fav.LastJoin = os.time()
            SaveConfig()
            Notify("Favorite updated", 1.4)
            RefreshFavorites()
            return
        end
    end
    table.insert(Config.Favorites, {
        JobId = JobId,
        PlaceId = PlaceId,
        LastJoin = os.time()
    })
    SaveConfig()
    Notify("Server added", 1.5)
    RefreshFavorites()
end

