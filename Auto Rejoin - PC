local rejoinCooldown = false
local function DoRejoin()
    if rejoinCooldown then return end
    rejoinCooldown = true
    Notify("Rejoining...", 1.1)
    task.wait(Config.Delay)
    local ok = pcall(function()
        local options = Instance.new("TeleportOptions")
        options.ServerInstanceId = JobId
        TeleportService:TeleportAsync(PlaceId, {LocalPlayer}, options)
    end)
    if not ok then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceId, JobId, LocalPlayer)
        end)
    end
    task.delay(3, function() rejoinCooldown = false end)
end

local function DoServerHop()
    Notify("Server Hopping...", 1.1)
    task.wait(0.35)
    pcall(function() TeleportService:Teleport(PlaceId, LocalPlayer) end)
end

local function Copy(text, label)
    if setclipboard then
        setclipboard(tostring(text))
        Notify(label .. " copied!", 1.5)
    else
        Notify("Clipboard not supported", 1.5)
    end
end

local function TimeAgo(ts)
    local diff = os.time() - (ts or 0)
    if diff < 60 then return diff .. "s ago" end
    if diff < 3600 then return math.floor(diff / 60) .. "m ago" end
    if diff < 86400 then return math.floor(diff / 3600) .. "h ago" end
    return math.floor(diff / 86400) .. "d ago"
end

-- FIXED DRAG: uses only UserInputService, no overlapping blockers that kill drag
local function MakeDraggable(frame, onEnd)
    local dragging = false
    local dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if onEnd then onEnd() end
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function GetInputName(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name, "KeyCode"
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        return "Mouse1", "UserInputType"
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        return "Mouse2", "UserInputType"
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        return "Mouse3", "UserInputType"
    end
    if input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
        local n = input.KeyCode.Name
        if n:find("Mouse") or n:find("Button") or n == "XButton1" or n == "XButton2" then
            return n, "KeyCode"
        end
    end
    return nil, nil
end

local function MatchInput(input, name, itype)
    if itype == "KeyCode" then return input.KeyCode.Name == name end
    if itype == "UserInputType" then
        if name == "Mouse1" then return input.UserInputType == Enum.UserInputType.MouseButton1 end
        if name == "Mouse2" then return input.UserInputType == Enum.UserInputType.MouseButton2 end
        if name == "Mouse3" then return input.UserInputType == Enum.UserInputType.MouseButton3 end
    end
    return false
end

