UserInputService.InputBegan:Connect(function(input, gp)
    if waitingFor then
        local name, itype = GetInputName(input)
        if name then
            if waitingFor == "rejoin" then
                Config.KeyCode = name
                Config.KeyType = itype
                KeyBtn.Text = name
            else
                Config.ToggleKey = name
                Config.ToggleType = itype
                ToggleBtn.Text = name
            end
            waitingFor = nil
            SaveConfig()
        end
        return
    end
    if gp then return end
    if MatchInput(input, Config.KeyCode, Config.KeyType) then DoRejoin()
    elseif MatchInput(input, Config.ToggleKey, Config.ToggleType) then SetHidden(not Config.Hidden) end
end)

DelayBox.FocusLost:Connect(function()
